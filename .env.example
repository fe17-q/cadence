# All optional. Secrets are generated and stored in the database on first run if not set.
PORT=8787
DATA_DIR=./data                 # where the SQLite database lives (mount a persistent volume here in production)
APP_SECRET=                     # encrypts Canvas tokens at rest; set this in production
VAPID_PUBLIC_KEY=               # web push keys (generate with: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SYNC_HOURS=3                    # how often to check Canvas for new assignments
PUBLIC_URL=https://cadence.example.com   # used for the Google sign-in redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=                 # for the Drive file picker
GOOGLE_APP_ID=                  # Google Cloud project number

# Password reset emails (sent over HTTPS; Railway blocks SMTP)
BREVO_API_KEY=                   # brevo.com → SMTP & API → API keys
MAIL_FROM=Cadence <you@gmail.com> # must be a sender you verified in Brevo
# RESEND_API_KEY=                # alternative; needs a verified domain to email other people
